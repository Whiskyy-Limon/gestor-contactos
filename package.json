{
  "name": "gestor-contactos",
  "version": "0.1.0",
  "private": true,
  "description": "Gestor de contactos (clientes y proveedores) para una pequeña empresa",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "user:create": "node --env-file-if-exists=.env scripts/create-user.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.2.0",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "zod": "^4.6.7"
  }
}
