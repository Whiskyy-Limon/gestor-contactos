# Copia este archivo como .env y ajusta los valores. El archivo .env nunca se sube a git.

# Puerto HTTP del servidor.
PORT=3000

# Entorno de ejecución: development | production | test
NODE_ENV=development

# Secreto para firmar la cookie de sesión. OBLIGATORIO: sin él, o con menos de 32 caracteres,
# el servidor no arranca. Genera uno largo y aleatorio con:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Ruta del archivo SQLite, relativa a la raíz del proyecto.
DATABASE_PATH=storage/contactos.db

# Proxy inverso delante de la app (Nginx, Render, etc.). Déjalo vacío si no hay ninguno.
# Si hay proxy, indica cuántos hay entre internet y la app (normalmente 1). Sin esto, en producción
# Express no detecta HTTPS (no envía la cookie segura) y todas las peticiones parecen venir de la IP
# del proxy (el límite de intentos de login bloquearía a todos a la vez).
TRUST_PROXY=
