<%- include('partials/cabecera', { paginaDeAcceso: true }) %>
<div class="acceso">
  <div class="acceso__marca">
    <%- include('partials/icono-app', { clase: 'acceso__icono' }) %>
    <p class="acceso__nombre">Gestor de contactos</p>
    <p class="acceso__lema">Clientes y proveedores, en un solo lugar.</p>
  </div>

  <section class="tarjeta">
    <h1>Iniciar sesión</h1>

    <% if (error) { %>
      <p class="alerta" role="alert"><%= error %></p>
    <% } %>

    <form method="post" action="/login" class="formulario">
      <input type="hidden" name="_csrf" value="<%= csrfToken() %>">

      <div class="campo">
        <label for="correo">Correo</label>
        <input id="correo" name="correo" type="email" autocomplete="username" required autofocus value="<%= correo %>">
      </div>

      <div class="campo">
        <label for="password">Contraseña</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required>
      </div>

      <button type="submit" class="boton boton--ancho">Ingresar</button>
    </form>
  </section>
</div>
<%- include('partials/pie') %>
