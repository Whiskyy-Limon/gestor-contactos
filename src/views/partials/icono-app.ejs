<%#
  Ícono de la app: una persona en un cuadrado redondeado. Es decorativo (el nombre de la app
  siempre va al lado) y toma los colores del modo claro u oscuro desde estilos.css.
  Recibe `clase` (opcional) para el tamaño. public/favicon.svg es la misma figura.
-%>
<svg class="icono-app <%= locals.clase ?? '' %>" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <rect class="icono-app__fondo" width="32" height="32" rx="9"/>
  <circle class="icono-app__figura" cx="16" cy="12.5" r="4.75"/>
  <path class="icono-app__figura" d="M7.5 25.5c.9-4.6 4.3-7.25 8.5-7.25s7.6 2.65 8.5 7.25z"/>
</svg>
