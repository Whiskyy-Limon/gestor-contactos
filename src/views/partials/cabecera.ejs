<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %> · Gestor de contactos</title>
  <link rel="stylesheet" href="/css/estilos.css">
</head>
<body>
  <header class="barra">
    <a class="marca" href="/">Gestor de contactos</a>
    <% if (locals.usuario) { %>
      <nav class="barra__nav" aria-label="Principal">
        <a href="/contactos">Contactos</a>
        <a href="/contactos/nuevo">Nuevo contacto</a>
      </nav>
      <form method="post" action="/logout" class="barra__salir">
        <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
        <span class="barra__usuario"><%= usuario.nombre %></span>
        <button type="submit" class="boton boton--secundario">Cerrar sesión</button>
      </form>
    <% } %>
  </header>
  <main class="contenido">
    <%# tomarAviso no existe si el error ocurrió antes de cargar la sesión (por ejemplo, un formulario
        demasiado grande). -%>
    <% const aviso = locals.tomarAviso ? tomarAviso() : null; %>
    <% if (aviso) { %>
      <p class="aviso" role="status"><%= aviso %></p>
    <% } %>
