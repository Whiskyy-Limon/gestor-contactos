<%- include('../partials/cabecera') %>
<section class="tarjeta tarjeta--listado">
  <div class="encabezado">
    <h1 data-titulo-listado><%= titulo %></h1>
    <a href="/contactos/nuevo" class="boton">Nuevo contacto</a>
  </div>

  <%# B1: búsqueda y filtros. Es un formulario GET: sin JavaScript funciona con el botón "Buscar" o
      con Enter. public/js/busqueda.js oculta el botón y actualiza los resultados mientras se escribe
      (data-busqueda-en-vivo indica el id del contenedor de resultados). -%>
  <form method="get" action="/contactos" class="filtros" role="search" data-busqueda-en-vivo="resultados">
    <div class="campo filtros__busqueda">
      <label for="q">Buscar</label>
      <input id="q" name="q" type="search" value="<%= filtros.q %>" maxlength="<%= maximoBusqueda %>"
        placeholder="Nombre, DNI, teléfono o correo" autocomplete="off" aria-controls="resultados">
    </div>
    <div class="campo">
      <label for="tipo">Tipo</label>
      <select id="tipo" name="tipo" aria-controls="resultados">
        <option value="">Todos</option>
        <option value="cliente"<%= filtros.tipo === 'cliente' ? ' selected' : '' %>>Clientes</option>
        <option value="proveedor"<%= filtros.tipo === 'proveedor' ? ' selected' : '' %>>Proveedores</option>
      </select>
    </div>
    <div class="campo">
      <label for="estado">Estado</label>
      <select id="estado" name="estado" aria-controls="resultados">
        <option value="activos">Activos</option>
        <option value="archivados"<%= filtros.estado === 'archivados' ? ' selected' : '' %>>Archivados</option>
      </select>
    </div>
    <div class="filtros__acciones">
      <button type="submit" class="boton" data-boton-buscar>Buscar</button>
    </div>
  </form>

  <%# Anuncia la cantidad de resultados después de cada búsqueda en vivo. Está fuera de #resultados
      porque ese contenido se reemplaza, y una región que se reemplaza puede no anunciarse. Empieza
      vacía: al cargar la página no se anuncia nada. -%>
  <p class="visualmente-oculto" role="status" aria-live="polite" data-anuncio-busqueda></p>

  <div id="resultados" class="resultados">
    <%- include('resultados') %>
  </div>
</section>
<script type="module" src="/js/busqueda.js"></script>
<%- include('../partials/pie') %>
