<%- include('../partials/cabecera') %>
<section class="tarjeta tarjeta--listado">
  <div class="encabezado">
    <h1><%= titulo %></h1>
    <a href="/contactos/nuevo" class="boton">Nuevo contacto</a>
  </div>

  <%# B1: búsqueda y filtros. Es un formulario GET: funciona sin JavaScript y el resultado tiene su
      propia dirección (se puede recargar o guardar como marcador). -%>
  <form method="get" action="/contactos" class="filtros" role="search">
    <div class="campo filtros__busqueda">
      <label for="q">Buscar</label>
      <input id="q" name="q" type="search" value="<%= filtros.q %>" maxlength="<%= maximoBusqueda %>"
        placeholder="Nombre, DNI, teléfono o correo">
    </div>
    <div class="campo">
      <label for="tipo">Tipo</label>
      <select id="tipo" name="tipo">
        <option value="">Todos</option>
        <option value="cliente"<%= filtros.tipo === 'cliente' ? ' selected' : '' %>>Clientes</option>
        <option value="proveedor"<%= filtros.tipo === 'proveedor' ? ' selected' : '' %>>Proveedores</option>
      </select>
    </div>
    <div class="campo">
      <label for="estado">Estado</label>
      <select id="estado" name="estado">
        <option value="activos">Activos</option>
        <option value="archivados"<%= filtros.estado === 'archivados' ? ' selected' : '' %>>Archivados</option>
      </select>
    </div>
    <div class="filtros__acciones">
      <button type="submit" class="boton">Buscar</button>
      <% if (hayFiltros || filtros.estado !== 'activos') { %>
        <a href="/contactos" class="boton boton--secundario">Limpiar</a>
      <% } %>
    </div>
  </form>

  <% if (resultado.total === 0) { %>
    <p class="vacio">
      <% if (hayFiltros) { %>
        No se encontraron contactos con esa búsqueda.
      <% } else if (filtros.estado === 'archivados') { %>
        No hay contactos archivados.
      <% } else { %>
        Todavía no hay contactos. <a href="/contactos/nuevo">Crea el primero</a>.
      <% } %>
    </p>
  <% } else { %>
    <p class="resumen">Mostrando <%= resultado.desde %>–<%= resultado.hasta %> de <%= resultado.total %></p>

    <div class="tabla-contenedor">
      <table class="tabla">
        <thead>
          <tr>
            <th scope="col">Nombre</th>
            <th scope="col">DNI</th>
            <th scope="col">Teléfono</th>
            <th scope="col">Correo</th>
          </tr>
        </thead>
        <tbody>
          <% for (const contacto of resultado.contactos) { %>
            <tr>
              <td>
                <div class="tabla__nombre">
                  <%- include('../partials/avatar', { contacto, chico: true }) %>
                  <div>
                    <a href="/contactos/<%= contacto.id %>"><%= contacto.apellidos %>, <%= contacto.nombres %></a>
                    <span class="tabla__tipo tenue"><%= nombreDeTipo(contacto.tipo) %></span>
                  </div>
                </div>
              </td>
              <td><%= contacto.dni %></td>
              <td><%= contacto.telefono ? formatearTelefono(contacto.telefono.numero, contacto.telefono.tipo) : '' %></td>
              <td><%= contacto.correo ?? '' %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <% if (resultado.paginas > 1) { %>
      <nav class="paginacion" aria-label="Páginas">
        <% if (resultado.pagina > 1) { %>
          <a href="<%= enlace({ pagina: resultado.pagina - 1 }) %>" rel="prev">« Anterior</a>
        <% } %>
        <span>Página <%= resultado.pagina %> de <%= resultado.paginas %></span>
        <% if (resultado.pagina < resultado.paginas) { %>
          <a href="<%= enlace({ pagina: resultado.pagina + 1 }) %>" rel="next">Siguiente »</a>
        <% } %>
      </nav>
    <% } %>
  <% } %>
</section>
<%- include('../partials/pie') %>
