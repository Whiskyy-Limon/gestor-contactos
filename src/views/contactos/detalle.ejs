<%- include('../partials/cabecera') %>
<p class="volver"><a href="/contactos">← Contactos</a></p>
<article class="tarjeta tarjeta--ancha ficha">
  <%# C5: un contacto archivado es de solo lectura; se puede restaurar (sin confirmación, porque solo
      deshace el archivado). Uno activo se puede editar o archivar (con confirmación). -%>
  <% if (contacto.archivado) { %>
    <div class="archivado">
      <%- include('../partials/icono', { icono: 'archivo', clase: 'archivado__icono' }) %>
      <p>Este contacto está archivado: no aparece en el listado normal y no se puede editar.</p>
      <form method="post" action="/contactos/<%= contacto.id %>/restaurar">
        <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
        <button type="submit" class="boton">Restaurar</button>
      </form>
    </div>
  <% } %>

  <header class="ficha__cabecera">
    <%# C4: en un contacto activo, el avatar abre el menú de la foto; uno archivado no la cambia (C5). -%>
    <% if (contacto.archivado) { %>
      <%- include('../partials/avatar', { contacto, grande: true }) %>
    <% } else { %>
      <%- include('foto-menu') %>
    <% } %>
    <div class="ficha__titulo">
      <h1 class="ficha__nombre"><%= contacto.nombres %> <%= contacto.apellidos %></h1>
      <p class="etiquetas">
        <span class="etiqueta etiqueta--<%= contacto.tipo %>"><%= nombreDeTipo(contacto.tipo) %></span>
        <% if (contacto.archivado) { %>
          <span class="etiqueta etiqueta--archivado">Archivado</span>
        <% } %>
      </p>
    </div>
    <% if (!contacto.archivado) { %>
      <div class="acciones ficha__acciones">
        <a href="/contactos/<%= contacto.id %>/editar" class="boton">Editar</a>
        <a href="/contactos/<%= contacto.id %>/archivar" class="boton boton--peligro-contorno">Archivar</a>
      </div>
    <% } %>
  </header>

  <section class="ficha__seccion" aria-labelledby="titulo-datos">
    <h2 id="titulo-datos" class="ficha__subtitulo">Datos de contacto</h2>
    <dl class="datos-contacto">
      <div>
        <dt>DNI</dt>
        <dd class="numero"><%= contacto.dni %></dd>
      </div>
      <div>
        <dt>Teléfonos</dt>
        <dd>
          <ul class="lista-simple">
            <% for (const telefono of contacto.telefonos) { %>
              <li><span class="numero"><%= formatearTelefono(telefono.numero, telefono.tipo) %></span> <span class="tenue">· <%= telefono.tipo %></span></li>
            <% } %>
          </ul>
        </dd>
      </div>
      <div>
        <dt>Correos</dt>
        <dd>
          <ul class="lista-simple">
            <% for (const correo of contacto.correos) { %>
              <li><a href="mailto:<%= correo %>"><%= correo %></a></li>
            <% } %>
          </ul>
        </dd>
      </div>
    </dl>
  </section>

  <%# A1: quién y cuándo. -%>
  <footer class="ficha__pie">
    <h2 class="ficha__subtitulo">Registro de cambios</h2>
    <dl class="auditoria">
      <dt>Creado</dt>
      <dd><%= contacto.auditoria.creado.por %> · <%= formatearFecha(contacto.auditoria.creado.en) %></dd>

      <dt>Última modificación</dt>
      <dd><%= contacto.auditoria.actualizado.por %> · <%= formatearFecha(contacto.auditoria.actualizado.en) %></dd>

      <% if (contacto.auditoria.archivado) { %>
        <dt>Archivado</dt>
        <dd><%= contacto.auditoria.archivado.por %> · <%= formatearFecha(contacto.auditoria.archivado.en) %></dd>
      <% } %>
    </dl>
  </footer>
</article>
<% if (!contacto.archivado) { %>
  <script type="module" src="/js/foto.js"></script>
<% } %>
<%- include('../partials/pie') %>
