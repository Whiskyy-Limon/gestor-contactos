# Dependencias
node_modules/

# Variables de entorno (secretos). Solo se versiona la plantilla.
.env
.env.*
!.env.example

# Base de datos SQLite y sus archivos auxiliares (modo WAL / journal)
*.db
*.db-wal
*.db-shm
*.db-journal

# Fotos subidas por los usuarios: se ignora el contenido pero se conserva la carpeta
storage/uploads/*
!storage/uploads/.gitkeep

# Logs y reportes
npm-debug.log*
coverage/

# Configuración local y personal del agente
.claude/settings.local.json

# Sistema operativo
.DS_Store
